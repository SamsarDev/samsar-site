---
import type { CollectionEntry } from 'astro:content';
import Card from '../ui/Card.astro';

interface Props {
  prevPost?: CollectionEntry<'blog'> | undefined;
  nextPost?: CollectionEntry<'blog'> | undefined;
}

const { prevPost, nextPost } = Astro.props;
---

{(prevPost || nextPost) && (
  <nav
    aria-label="Navegación entre artículos"
    class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-12 pt-8 border-t border-[var(--border-base)]"
  >
    <div>
      {prevPost ? (
        <a href={`/blog/${prevPost.id}`} class="block group h-full focus-visible:outline-none">
          <Card variant="interactive" class="h-full">
            <span class="text-xs font-mono text-[var(--text-muted)] block mb-1">← Artículo anterior</span>
            <span class="font-display font-bold text-sm text-[var(--text-primary)] group-hover:text-[var(--accent-primary)] transition-colors line-clamp-2">
              {prevPost.data.title}
            </span>
          </Card>
        </a>
      ) : (
        <div />
      )}
    </div>
    <div>
      {nextPost ? (
        <a href={`/blog/${nextPost.id}`} class="block group h-full text-right sm:text-left focus-visible:outline-none">
          <Card variant="interactive" class="h-full">
            <span class="text-xs font-mono text-[var(--text-muted)] block mb-1">Siguiente artículo →</span>
            <span class="font-display font-bold text-sm text-[var(--text-primary)] group-hover:text-[var(--accent-primary)] transition-colors line-clamp-2">
              {nextPost.data.title}
            </span>
          </Card>
        </a>
      ) : (
        <div />
      )}
    </div>
  </nav>
)}
