---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/ui/Card.astro';
import Chip from '../components/ui/Chip.astro';
import Button from '../components/ui/Button.astro';
import avatarImg from '../assets/avatar.png';
import { profileData } from '../data/profile';
---

<BaseLayout
  title="Sobre mí | Samuel Sarmientos"
  description="Presentación personal, valores de ingeniería de software, áreas de exploración y filosofía técnica de Samuel Sarmientos."
>
  <!-- Hero Personal -->
  <header class="py-16 sm:py-24 border-b border-[var(--border-base)] bg-[var(--bg-surface)]">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 flex flex-col sm:flex-row items-center sm:items-start gap-8 sm:gap-12">
      <div class="relative shrink-0">
        <div class="w-36 h-36 sm:w-44 sm:h-44 rounded-2xl overflow-hidden border-2 border-[var(--accent-primary)]/40 shadow-xl bg-[var(--bg-surface-elevated)] p-1">
          <Image
            src={avatarImg}
            alt={profileData.name}
            class="w-full h-full object-cover rounded-xl"
            loading="eager"
          />
        </div>
        <div class="absolute -bottom-2 -right-2 px-2.5 py-1 rounded-full bg-[var(--bg-surface)] border border-[var(--border-base)] shadow-sm text-[10px] font-mono font-medium text-[var(--accent-primary)]">
          Senior Lead
        </div>
      </div>

      <div class="text-center sm:text-left flex-1">
        <div class="flex flex-wrap items-center justify-center sm:justify-start gap-3 mb-2">
          <span class="font-mono text-xs text-[var(--accent-primary)] uppercase tracking-wider">
            {profileData.location}
          </span>
          <span class="text-xs text-[var(--text-muted)]">•</span>
          <span class="font-mono text-xs text-[var(--text-secondary)]">
            ~10 años en Ingeniería
          </span>
        </div>

        <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-[var(--text-primary)] tracking-tight">
          {profileData.name}
        </h1>

        <p class="mt-3 text-lg text-[var(--text-secondary)] font-sans leading-relaxed">
          {profileData.tagline}
        </p>

        <div class="mt-6 flex flex-wrap items-center justify-center sm:justify-start gap-4">
          <Button href="/experiencia" variant="primary" size="sm">
            Ver trayectoria profesional &rarr;
          </Button>
          <Button href="/contacto" variant="secondary" size="sm">
            Iniciar conversación
          </Button>
        </div>
      </div>
    </div>
  </header>

  <main class="py-16 mx-auto max-w-4xl px-4 sm:px-6 space-y-20">
    <!-- Biografía Narrativa -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="font-mono text-xs text-[var(--accent-primary)] uppercase tracking-wider">
          01 // Manifiesto
        </span>
        <div class="h-px flex-1 bg-[var(--border-base)]"></div>
      </div>
      <h2 class="font-display text-2xl sm:text-3xl font-bold text-[var(--text-primary)] mb-6">
        Biografía & Perspectiva Técnica
      </h2>
      <div class="space-y-4 text-base sm:text-lg text-[var(--text-secondary)] font-sans leading-relaxed">
        {profileData.bioParagraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </section>

    <!-- Áreas de Interés -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="font-mono text-xs text-[var(--accent-primary)] uppercase tracking-wider">
          02 // Enfoque
        </span>
        <div class="h-px flex-1 bg-[var(--border-base)]"></div>
      </div>
      <h2 class="font-display text-2xl sm:text-3xl font-bold text-[var(--text-primary)] mb-8">
        Áreas de Interés & Especialización
      </h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {profileData.interestAreas.map((area) => (
          <Card variant="interactive" class="flex flex-col justify-between h-full">
            <div>
              <h3 class="font-display text-lg font-bold text-[var(--text-primary)] mb-2">
                {area.title}
              </h3>
              <p class="text-sm text-[var(--text-secondary)] leading-relaxed font-sans">
                {area.description}
              </p>
            </div>
          </Card>
        ))}
      </div>
    </section>

    <!-- Valores y Filosofía -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="font-mono text-xs text-[var(--accent-primary)] uppercase tracking-wider">
          03 // Filosofía
        </span>
        <div class="h-px flex-1 bg-[var(--border-base)]"></div>
      </div>
      <h2 class="font-display text-2xl sm:text-3xl font-bold text-[var(--text-primary)] mb-8">
        Principios de Ingeniería
      </h2>
      <div class="space-y-4">
        {profileData.principles.map((principle) => (
          <div class="p-6 rounded-xl border border-[var(--border-base)] bg-[var(--bg-surface)] flex flex-col sm:flex-row gap-4 sm:gap-6 items-start">
            <span class="font-mono text-lg font-bold text-[var(--accent-primary)] shrink-0 px-2.5 py-1 rounded-md bg-[var(--accent-primary)]/10">
              {principle.number}
            </span>
            <div>
              <h3 class="font-display text-lg font-bold text-[var(--text-primary)] mb-1">
                {principle.title}
              </h3>
              <p class="text-sm text-[var(--text-secondary)] leading-relaxed font-sans">
                {principle.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Stack de Dominio -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="font-mono text-xs text-[var(--accent-primary)] uppercase tracking-wider">
          04 // Competencias
        </span>
        <div class="h-px flex-1 bg-[var(--border-base)]"></div>
      </div>
      <h2 class="font-display text-2xl sm:text-3xl font-bold text-[var(--text-primary)] mb-8">
        Stack Tecnológico Consolidado
      </h2>
      <div class="grid gap-6 sm:grid-cols-2">
        {profileData.skillCategories.map((group) => (
          <div class="p-6 rounded-xl border border-[var(--border-base)] bg-[var(--bg-surface)]">
            <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-[var(--accent-primary)] mb-4">
              {group.category}
            </h3>
            <div class="flex flex-wrap gap-2">
              {group.skills.map((skill) => (
                <Chip variant="stack">{skill}</Chip>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Fuera de la Terminal -->
    <section>
      <div class="p-8 rounded-2xl border border-[var(--border-base)] bg-gradient-to-br from-[var(--bg-surface)] to-[var(--bg-surface-elevated)] relative overflow-hidden">
        <div class="flex items-center gap-2 font-mono text-xs text-[var(--accent-primary)] uppercase tracking-wider mb-3">
          <span>05 // Dimensión Humana</span>
        </div>
        <h2 class="font-display text-2xl font-bold text-[var(--text-primary)] mb-4">
          Fuera de la Terminal
        </h2>
        <p class="text-base text-[var(--text-secondary)] font-sans leading-relaxed">
          {profileData.outsideTerminal}
        </p>
      </div>
    </section>

    <!-- CTA Contacto -->
    <section class="text-center py-12 px-6 rounded-2xl border border-[var(--border-base)] bg-[var(--bg-surface)]">
      <h2 class="font-display text-2xl sm:text-3xl font-bold text-[var(--text-primary)] mb-3">
        ¿Tienes una idea, consulta técnica o proyecto?
      </h2>
      <p class="text-base text-[var(--text-secondary)] font-sans max-w-xl mx-auto mb-6">
        Siempre con apertura para colaborar en iniciativas de alto impacto, mentoría técnica, o resolver retos de arquitectura distribuida e inteligencia artificial.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <Button href="/contacto" variant="primary" size="md">
          Hablemos &rarr;
        </Button>
        <Button href="/experiencia" variant="secondary" size="md">
          Consultar trayectoria
        </Button>
      </div>
    </section>
  </main>
</BaseLayout>
