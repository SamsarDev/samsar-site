---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectCard from '../../../components/portfolio/ProjectCard.astro';
import Chip from '../../../components/ui/Chip.astro';

export async function getStaticPaths() {
  const types = ['professional', 'open-source', 'game', 'ai-experiment'] as const;
  const allProjects = await getCollection('projects');

  return types.map((t) => {
    const filtered = allProjects.filter((p) => p.data.type === t);
    return {
      params: { type: t },
      props: { type: t, projects: filtered },
    };
  });
}

interface Props {
  type: 'professional' | 'open-source' | 'game' | 'ai-experiment';
  projects: Awaited<ReturnType<typeof getCollection<'projects'>>>;
}

const { type, projects } = Astro.props;

const typeMeta: Record<string, { title: string; desc: string }> = {
  professional: {
    title: 'Proyectos Profesionales',
    desc: 'Arquitecturas empresariales, modernización de sistemas legacy y soluciones cloud distribuidas.',
  },
  'open-source': {
    title: 'Proyectos Open Source',
    desc: 'Herramientas de código abierto, bibliotecas y plantillas de arquitectura compartidas con la comunidad.',
  },
  game: {
    title: 'Videojuegos & Dinámicas Lúdicas',
    desc: 'Experiencias gamificadas en 3D y juegos desarrollados con fines formativos y familiares.',
  },
  'ai-experiment': {
    title: 'Experimentos de IA & Agentes',
    desc: 'Exploraciones prácticas con arquitecturas agénticas, servidores MCP, LangGraph y canalizaciones RAG.',
  },
};

const meta = typeMeta[type] || {
  title: 'Proyectos',
  desc: 'Iniciativas y desarrollos de software.',
};

const filterTabs = [
  { label: 'Todos', href: '/proyectos', active: false },
  { label: 'Profesionales', href: '/proyectos/professional', active: type === 'professional' },
  { label: 'Open Source', href: '/proyectos/open-source', active: type === 'open-source' },
  { label: 'Juegos', href: '/proyectos/game', active: type === 'game' },
  { label: 'Experimentos IA', href: '/proyectos/ai-experiment', active: type === 'ai-experiment' },
];
---

<BaseLayout
  title={`${meta.title} | Proyectos Samsar`}
  description={meta.desc}
>
  <main class="py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <header class="mb-12">
        <p class="font-mono text-xs text-[var(--accent-primary)] uppercase tracking-wider mb-2">
          Filtrado por tipo • {projects.length} {projects.length === 1 ? 'proyecto' : 'proyectos'}
        </p>
        <h1 class="font-display text-4xl sm:text-5xl font-bold text-[var(--text-primary)] mb-4">
          {meta.title}
        </h1>
        <p class="text-lg text-[var(--text-secondary)] leading-relaxed max-w-2xl font-sans">
          {meta.desc}
        </p>

        <!-- Barra de filtros estáticos -->
        <nav aria-label="Filtrar proyectos por tipo" class="flex flex-wrap gap-2 mt-8 pt-6 border-t border-[var(--border-base)]">
          {filterTabs.map((tab) => (
            <a href={tab.href} class="focus-visible:outline-none">
              <Chip
                variant="category"
                class={tab.active ? 'bg-[var(--accent-primary)] text-[var(--text-on-accent)] border-[var(--accent-primary)]' : ''}
              >
                {tab.label}
              </Chip>
            </a>
          ))}
        </nav>
      </header>

      {projects.length > 0 ? (
        <section aria-label={`Listado de ${meta.title}`} class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {projects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </section>
      ) : (
        <div class="py-16 text-center text-[var(--text-muted)] font-mono text-sm">
          No hay proyectos registrados en esta categoría aún.
        </div>
      )}
    </div>
  </main>
</BaseLayout>
