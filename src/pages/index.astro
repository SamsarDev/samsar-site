---
import '../styles/global.css';

const title = 'Samsar | Sitio web personal';
---

<html lang="es" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-[var(--bg-primary)] text-[var(--text-primary)] font-[family-name:var(--font-body)] antialiased">
    <main class="mx-auto max-w-4xl px-4 py-16">
      <div class="rounded-xl border border-[var(--border-base)] bg-[var(--bg-surface)] p-8 shadow-sm">
        <h1 class="text-3xl font-bold text-[var(--text-primary)] font-[family-name:var(--font-display)]">
          {title}
        </h1>
        <p class="mt-4 text-base text-[var(--text-secondary)]">
          Andamiaje base de Astro con Tailwind CSS v4, tokens semánticos de Obsidiana & Jade y tipografía autoalojada.
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
          <span class="inline-flex items-center rounded-md bg-[var(--accent-primary)] px-3 py-1 text-sm font-medium text-[var(--text-on-accent)]">
            Acento Activo
          </span>
          <code class="rounded bg-[var(--bg-subtle)] px-2 py-1 font-[family-name:var(--font-mono)] text-sm text-[var(--text-link)]">
            bun run dev
          </code>
        </div>
      </div>
    </main>
  </body>
</html>
