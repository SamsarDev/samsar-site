---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperienceTimeline from '../components/islands/ExperienceTimeline.vue';
import Button from '../components/ui/Button.astro';
import { experienceData } from '../data/experience';
---

<BaseLayout
  title="Experiencia Profesional | Samuel Sarmientos"
  description="Trayectoria profesional, arquitectura de sistemas distribuidos, IA agéntica, liderazgo técnico y currículum descargable de Samuel Sarmientos."
>
  <!-- Encabezado y Descarga de CV -->
  <header class="py-16 sm:py-24 border-b border-[var(--border-base)] bg-[var(--bg-surface)]">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 mb-8">
        <div>
          <p class="font-mono text-xs uppercase tracking-wider text-[var(--accent-primary)] mb-2">
            Trayectoria & Impacto
          </p>
          <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-[var(--text-primary)] tracking-tight">
            Experiencia Profesional
          </h1>
        </div>

        <a
          href="/cv-samuel-sarmientos.pdf"
          download="CV-Samuel-Sarmientos.pdf"
          class="inline-flex items-center justify-center gap-2.5 px-5 py-2.5 rounded-lg bg-[var(--accent-primary)] text-[var(--text-on-accent)] font-semibold text-sm hover:opacity-90 transition-opacity focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--border-focus)] shadow-sm shrink-0"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          Descargar CV (PDF)
        </a>
      </div>

      <p class="text-base sm:text-lg text-[var(--text-secondary)] font-sans leading-relaxed">
        {experienceData.summary}
      </p>
    </div>
  </header>

  <main class="py-16 mx-auto max-w-4xl px-4 sm:px-6 space-y-20">
    <!-- Timeline Interactivo -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="font-mono text-xs text-[var(--accent-primary)] uppercase tracking-wider">
          01 // Cronología
        </span>
        <div class="h-px flex-1 bg-[var(--border-base)]"></div>
      </div>
      <h2 class="font-display text-2xl sm:text-3xl font-bold text-[var(--text-primary)] mb-8">
        Línea de Tiempo Profesional
      </h2>

      <ExperienceTimeline client:visible experiences={experienceData.experiences} />
    </section>

    <!-- Educación y Estudios -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="font-mono text-xs text-[var(--accent-primary)] uppercase tracking-wider">
          02 // Formación
        </span>
        <div class="h-px flex-1 bg-[var(--border-base)]"></div>
      </div>
      <h2 class="font-display text-2xl sm:text-3xl font-bold text-[var(--text-primary)] mb-8">
        Educación & Estudios
      </h2>

      <div class="grid gap-4 sm:grid-cols-2">
        {experienceData.education.map((item) => (
          <div class="p-6 rounded-xl border border-[var(--border-base)] bg-[var(--bg-surface)] flex flex-col justify-between">
            <div>
              <span class="font-mono text-xs text-[var(--accent-primary)] font-semibold">
                {item.period}
              </span>
              <h3 class="font-display text-lg font-bold text-[var(--text-primary)] mt-1 mb-1">
                {item.degree}
              </h3>
              <p class="text-sm text-[var(--text-secondary)] font-sans">
                {item.institution}
              </p>
            </div>
            {item.details && (
              <p class="mt-4 pt-3 border-t border-[var(--border-base)]/50 text-xs text-[var(--text-muted)] font-sans">
                {item.details}
              </p>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- Certificaciones y Especializaciones -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="font-mono text-xs text-[var(--accent-primary)] uppercase tracking-wider">
          03 // Especialización
        </span>
        <div class="h-px flex-1 bg-[var(--border-base)]"></div>
      </div>
      <h2 class="font-display text-2xl sm:text-3xl font-bold text-[var(--text-primary)] mb-8">
        Certificaciones & Credenciales
      </h2>

      <div class="grid gap-4 sm:grid-cols-2">
        {experienceData.certifications.map((cert) => (
          <div class="p-5 rounded-xl border border-[var(--border-base)] bg-[var(--bg-surface)] flex items-start justify-between gap-4">
            <div>
              <h3 class="font-display text-base font-bold text-[var(--text-primary)]">
                {cert.name}
              </h3>
              <p class="text-xs text-[var(--text-secondary)] font-sans mt-0.5">
                {cert.issuer}
              </p>
            </div>
            <span class="font-mono text-xs font-semibold px-2 py-0.5 rounded bg-[var(--bg-surface-elevated)] border border-[var(--border-base)] text-[var(--text-muted)] shrink-0">
              {cert.year}
            </span>
          </div>
        ))}
      </div>
    </section>

    <!-- Idiomas -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="font-mono text-xs text-[var(--accent-primary)] uppercase tracking-wider">
          04 // Idiomas
        </span>
        <div class="h-px flex-1 bg-[var(--border-base)]"></div>
      </div>
      <h2 class="font-display text-2xl sm:text-3xl font-bold text-[var(--text-primary)] mb-8">
        Idiomas
      </h2>

      <div class="grid gap-4 sm:grid-cols-2">
        {experienceData.languages.map((lang) => (
          <div class="p-5 rounded-xl border border-[var(--border-base)] bg-[var(--bg-surface)]">
            <div class="flex items-baseline justify-between mb-1">
              <h3 class="font-display text-lg font-bold text-[var(--text-primary)]">
                {lang.language}
              </h3>
              <span class="font-mono text-xs text-[var(--accent-primary)] font-semibold">
                {lang.level}
              </span>
            </div>
            {lang.description && (
              <p class="text-xs text-[var(--text-secondary)] font-sans">
                {lang.description}
              </p>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- CTA Profesional -->
    <section class="text-center py-12 px-6 rounded-2xl border border-[var(--border-base)] bg-[var(--bg-surface)]">
      <h2 class="font-display text-2xl sm:text-3xl font-bold text-[var(--text-primary)] mb-3">
        ¿Interesado en colaborar profesionalmente?
      </h2>
      <p class="text-base text-[var(--text-secondary)] font-sans max-w-xl mx-auto mb-6">
        Disponible para liderazgo técnico, consultorías en modernización hacia arquitecturas agénticas y orquestación de sistemas distribuidos en la nube.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <Button href="/contacto" variant="primary" size="md">
          Conectar profesionalmente &rarr;
        </Button>
        <a
          href="/cv-samuel-sarmientos.pdf"
          download="CV-Samuel-Sarmientos.pdf"
          class="inline-flex items-center justify-center px-4 py-2 min-h-[44px] rounded-lg border border-[var(--border-base)] bg-transparent text-[var(--text-primary)] hover:bg-[var(--bg-subtle)] font-medium text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--border-focus)]"
        >
          Descargar PDF
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
