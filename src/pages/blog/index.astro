---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/blog/PostCard.astro';
import Chip from '../../components/ui/Chip.astro';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const categories = [
  { label: 'Todos', href: '/blog', active: true },
  { label: 'Samsar|Dev', href: '/blog/samsar-dev', active: false },
  { label: 'Samsar|IA', href: '/blog/samsar-ia', active: false },
  { label: 'Samsar|Games', href: '/blog/samsar-games', active: false },
];
---

<BaseLayout
  title="Cuaderno de campo & Blog | Samsar"
  description="Publicaciones técnicas sobre arquitectura de software, inteligencia artificial y diseño de videojuegos familiares."
>
  <main class="py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <header class="mb-12">
        <p class="font-mono text-xs text-[var(--accent-primary)] uppercase tracking-wider mb-2">
          Publicaciones & Reflexiones
        </p>
        <h1 class="font-display text-4xl sm:text-5xl font-bold text-[var(--text-primary)] mb-4">
          Cuaderno de campo & Blog
        </h1>
        <p class="text-lg text-[var(--text-secondary)] leading-relaxed max-w-2xl font-sans">
          Exploraciones técnicas, manuales de arquitectura, apuntes de inteligencia artificial y crónicas de videojuegos
          desarrollados en familia.
        </p>

        <!-- Filtros por categoría -->
        <nav
          aria-label="Filtrar por categoría"
          class="flex flex-wrap gap-2 mt-8 pt-6 border-t border-[var(--border-base)]"
        >
          {categories.map((cat) => (
            <a href={cat.href} class="focus-visible:outline-none">
              <Chip
                variant="category"
                class={
                  cat.active
                    ? 'bg-[var(--accent-primary)] text-[var(--text-on-accent)] border-[var(--accent-primary)]'
                    : ''
                }
              >
                {cat.label}
              </Chip>
            </a>
          ))}
        </nav>
      </header>

      <!-- Grid de artículos -->
      <section aria-label="Listado de artículos" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {allPosts.map((post) => (
          <PostCard post={post} />
        ))}
      </section>
    </div>
  </main>
</BaseLayout>
