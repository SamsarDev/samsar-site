---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CategoryHero from '../../../components/blog/CategoryHero.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import Chip from '../../../components/ui/Chip.astro';

export async function getStaticPaths() {
  const categories = ['samsar-dev', 'samsar-ia', 'samsar-games'] as const;
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);

  return categories.map((cat) => {
    const posts = allPosts
      .filter((post) => post.data.category === cat)
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    return {
      params: { category: cat },
      props: { category: cat, posts },
    };
  });
}

interface Props {
  category: 'samsar-dev' | 'samsar-ia' | 'samsar-games';
  posts: Awaited<ReturnType<typeof getCollection<'blog'>>>;
}

const { category, posts } = Astro.props;

const categoryMeta = {
  'samsar-dev': { title: 'Samsar|Dev', desc: 'Guías de arquitectura y desarrollo de software' },
  'samsar-ia': { title: 'Samsar|IA', desc: 'Exploraciones sobre IA generativa, agentes y MCP' },
  'samsar-games': { title: 'Samsar|Games', desc: 'Videojuegos y dinámicas formativas en familia' },
}[category];

const categoriesNav = [
  { label: 'Todos', href: '/blog', active: false },
  { label: 'Samsar|Dev', href: '/blog/samsar-dev', active: category === 'samsar-dev' },
  { label: 'Samsar|IA', href: '/blog/samsar-ia', active: category === 'samsar-ia' },
  { label: 'Samsar|Games', href: '/blog/samsar-games', active: category === 'samsar-games' },
];
---

<BaseLayout title={`${categoryMeta.title} | Blog Samsar`} description={categoryMeta.desc}>
  <CategoryHero category={category} count={posts.length} />

  <main class="py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <nav
        aria-label="Filtrar por categoría"
        class="flex flex-wrap gap-2 mb-10 pb-6 border-b border-[var(--border-base)]"
      >
        {categoriesNav.map((cat) => (
          <a href={cat.href} class="focus-visible:outline-none">
            <Chip
              variant="category"
              class={
                cat.active
                  ? 'bg-[var(--accent-primary)] text-[var(--text-on-accent)] border-[var(--accent-primary)]'
                  : ''
              }
            >
              {cat.label}
            </Chip>
          </a>
        ))}
      </nav>

      {posts.length > 0 ? (
        <section
          aria-label={`Artículos de ${categoryMeta.title}`}
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
        >
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </section>
      ) : (
        <div class="py-16 text-center text-[var(--text-muted)] font-mono text-sm">
          No hay artículos publicados todavía en esta categoría.
        </div>
      )}
    </div>
  </main>
</BaseLayout>
