---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/blog/Breadcrumbs.astro';
import CodeBlock from '../components/blog/CodeBlock.astro';
import TOC from '../components/blog/TOC.astro';
import type { MarkdownHeading } from 'astro';

interface Props {
  title: string;
  description: string;
  headings: MarkdownHeading[];
  category: 'samsar-dev' | 'samsar-ia' | 'samsar-games';
  pubDate: Date;
}

const { title, description, headings, category, pubDate } = Astro.props;

const categoryLabels = {
  'samsar-dev': 'Samsar|Dev',
  'samsar-ia': 'Samsar|IA',
  'samsar-games': 'Samsar|Games',
};
---

<BaseLayout title={`${title} | ${categoryLabels[category]}`} description={description}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10" itemscope itemtype="https://schema.org/BlogPosting">
    <meta itemprop="datePublished" content={pubDate.toISOString()} />
    <meta itemprop="headline" content={title} />
    <meta itemprop="description" content={description} />

    <Breadcrumbs
      items={[
        { label: 'Blog', href: '/blog' },
        { label: categoryLabels[category], href: `/blog/${category}` },
        { label: title },
      ]}
    />

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_260px] gap-12 items-start">
      <article class="max-w-[70ch] mx-auto lg:mx-0 w-full prose-samsar">
        <slot />
      </article>

      <aside class="hidden lg:block sticky top-24">
        <TOC headings={headings} />
      </aside>
    </div>
  </div>

  <style is:global>
    /* Estilos de lectura tipográfica */
    .prose-samsar {
      color: var(--text-primary);
      font-family: var(--font-body);
      line-height: 1.7;
    }
    .prose-samsar p {
      margin-bottom: 1.5rem;
      font-size: 1.0625rem;
    }
    .prose-samsar h2 {
      font-family: var(--font-display);
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--text-primary);
      margin-top: 2.5rem;
      margin-bottom: 1rem;
      scroll-margin-top: 6rem;
    }
    .prose-samsar h3 {
      font-family: var(--font-display);
      font-size: 1.35rem;
      font-weight: 600;
      color: var(--text-primary);
      margin-top: 2rem;
      margin-bottom: 0.75rem;
      scroll-margin-top: 6rem;
    }
    .prose-samsar ul,
    .prose-samsar ol {
      margin-bottom: 1.5rem;
      padding-left: 1.5rem;
    }
    .prose-samsar ul {
      list-style-type: disc;
    }
    .prose-samsar ol {
      list-style-type: decimal;
    }
    .prose-samsar li {
      margin-bottom: 0.5rem;
    }
    .prose-samsar code:not(pre code) {
      font-family: var(--font-mono);
      font-size: 0.875em;
      padding: 0.15rem 0.35rem;
      border-radius: 0.25rem;
      background-color: var(--bg-subtle);
      border: 1px solid var(--border-base);
      color: var(--accent-primary);
    }
  </style>

  <!-- Owns the chrome and the behaviour of every code block in the post. -->
  <CodeBlock />
</BaseLayout>
